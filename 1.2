Вторая Задача:

public class Main {
    public static void main(String[] args) {
        java.util.Scanner scanner = new java.util.Scanner(System.in);
        long userNumber = scanner.nextLong();
        long userSum = 0;
        
        while (userNumber > 0) {
            long userNextNumber = userNumber % 10;
            userNumber = userNumber / 10;
            userSum = userSum + userNextNumber;
        }
        
        System.out.println(userSum);
    }
}

